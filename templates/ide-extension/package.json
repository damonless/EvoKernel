{
  "name": "evo-kernel-cockpit",
  "displayName": "EvoKernel Workbench",
  "description": "AST-Verified Cognitive Memory & Deterministic Context OS Workbench for AI Agents",
  "version": "0.3.0",
  "publisher": "damonless",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daming56/EvoKernel"
  },
  "homepage": "https://github.com/daming56/EvoKernel#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Developer Tools",
    "Other"
  ],
  "keywords": [
    "evo-kernel",
    "workbench",
    "cockpit",
    "cognitive-memory",
    "prompt-cache",
    "mcp"
  ],
  "activationEvents": [
    "onCommand:evo.openWorkbench",
    "onCommand:evo.viewCockpit"
  ],
  "main": "./index.js",
  "contributes": {
    "commands": [
      {
        "command": "evo.openWorkbench",
        "title": "EvoKernel: Open Workbench",
        "category": "EvoKernel",
        "icon": "$(dashboard)"
      },
      {
        "command": "evo.viewCockpit",
        "title": "EvoKernel: Open Workbench (Legacy Alias)",
        "category": "EvoKernel",
        "icon": "$(layout-panel)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "evo.openWorkbench",
          "when": "true"
        },
        {
          "command": "evo.viewCockpit",
          "when": "true"
        }
      ]
    }
  }
}
