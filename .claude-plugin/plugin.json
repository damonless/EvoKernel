{
  "name": "evo-kernel",
  "version": "0.4.0",
  "description": "Deterministic Self-Evolving Meta-Kernel & Zero-Dep Lexical-Structural Symbol Fingerprinting with Offline Worktree Evolution, Deliverable Inspection, and Fixed 5-Tool Meta-MCP Gateway for AI Coding Agents",
  "author": {
    "name": "EvoKernel Contributors"
  },
  "mcpServers": {
    "evo-kernel": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/boot-mcp.mjs", "mcp"]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/boot-mcp.mjs\" hook post-tool --harness claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/boot-mcp.mjs\" hook stop --harness claude"
          }
        ]
      }
    ]
  }
}
