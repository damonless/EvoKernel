{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/cli/index.js hook post-tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/cli/index.js hook stop"
          }
        ]
      }
    ],
    "post-tool": [
      {
        "command": "node ./dist/cli/index.js hook post-tool"
      }
    ],
    "stop": [
      {
        "command": "node ./dist/cli/index.js hook stop"
      }
    ]
  }
}
